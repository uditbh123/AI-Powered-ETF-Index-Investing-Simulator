# Copy to .env and fill in values. Never commit .env.
# ------------------------------------------------------------------
# SQLite database file location (relative to the backend/ directory).
DATABASE_URL=sqlite:///./simulator.db

# Market data provider (yfinance pulls data without an API key,
# free tier only). Leave empty for now; used by Phase 1 ingestion.
MARKET_DATA_API_KEY=

# News API key (NewsAPI free tier / RSS feeds). Used by Phase 5 sentiment.
NEWS_API_KEY=